# LifeTrack sync server configuration (template -- copy to .env and fill in)
# Never commit the real .env to git.

# MongoDB Atlas connection string (Atlas -> Database -> Connect -> Drivers)
MONGO_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<name>"

# Database name
DB=lifetrack

# HTTP port
PORT=3000

# Optional shared secret for /api/data requests (header: x-sync-key)
#SYNC_KEY=change-me-to-a-long-random-string
